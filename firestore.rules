rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    function signedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário já é membro do workspace
    function isMember(workspaceId) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // Busca o papel (role) do usuário no workspace
    function getRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    // Verifica permissões de Admin/Owner
    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && getRole(workspaceId) in roles;
    }

    // Verifica se o usuário é o dono original do documento do Workspace
    function isWorkspaceOwner(workspaceId) {
      return signedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // --- REGRAS POR COLEÇÃO ---

    match /workspaces/{workspaceId} {
      // Regras do documento principal do Workspace
      allow create: if signedIn();
      allow read: if isMember(workspaceId);
      allow update: if hasRole(workspaceId, ['owner', 'admin']);

      // Subcoleção de Membros
      match /members/{memberId} {
        // Permite listar os próprios workspaces e ver colegas se já for membro
        allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isMember(workspaceId);
        
        // Permite escrita para admins ou para o dono se auto-adicionar na criação
        allow write: if hasRole(workspaceId, ['owner', 'admin']) 
                     || (request.auth.uid == memberId && isWorkspaceOwner(workspaceId));
      }

      // Transações (Módulo Principal)
      match /transactions/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }

      // --- MÓDULOS EM TRANSIÇÃO DE SEGURANÇA ---
      // Liberados para qualquer usuário logado enquanto finalizamos a migração total
      match /recurring_expenses/{docId} { allow read, write: if signedIn(); }
      match /recurring_occurrences/{docId} { allow read, write: if signedIn(); }
      match /credit_cards/{docId} { allow read, write: if signedIn(); }
      match /goals/{docId} { allow read, write: if signedIn(); }
      match /loans/{docId} { allow read, write: if signedIn(); }
      match /loan_movements/{docId} { allow read, write: if signedIn(); }
      match /clients/{docId} { allow read, write: if signedIn(); }
      match /receivables/{docId} { allow read, write: if signedIn(); }
      match /notifications/{docId} { allow read, write: if signedIn(); }

      // --- MÓDULO DE RATEIOS (Split Bills) ---
      match /split_groups/{docId} { allow read, write: if signedIn(); }
      match /split_participants/{docId} { allow read, write: if signedIn(); }
      match /split_bills/{docId} { allow read, write: if signedIn(); }
      match /split_shares/{docId} { allow read, write: if signedIn(); }
      
      // 🔒 SEGURANÇA MÁXIMA: Leitura liberada, mas escrita BLOQUEADA para o frontend.
      // Somente as Cloud Functions (Admin SDK) conseguem gravar aqui.
      match /split_invites/{docId} { 
        allow read: if signedIn(); 
        allow write: if false; 
      }

      // Regra genérica para qualquer outra subcoleção dentro de um workspace
      match /{subCollection}/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }
    }

    // Regra para mapeamento de Workspaces do Usuário (Legado/Auxiliar)
    match /users/{userId}/workspaces/{workspaceId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}