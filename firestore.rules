rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // P1 — autorização canônica por membership ativo.
    //
    // A única fonte de papel é `workspaces/{id}/members/{uid}` com
    // `status == 'active'`; `workspace.ownerId` é só desnormalizado e não
    // concede nada (D-03). Não existe mais o regime `ownerId` por documento
    // pai: um owner sem membership ativo não lê nem escreve.
    //
    // Conta suspensa (D-P1-SUSP): toda decisão de membership exige também
    // `users/{uid}.status == 'active'`. É o que fecha a janela do ID token
    // ainda vigente depois da suspensão: o token continua válido por até uma
    // hora, mas o perfil já está `suspended` e toda leitura ou escrita de
    // dados de workspace é negada na requisição seguinte.
    //
    // Custo: um `get` a mais por requisição (o documento do perfil é o mesmo
    // em toda a avaliação e conta uma vez — as chamadas `get`/`exists` ao
    // mesmo documento são deduplicadas dentro da requisição). O pior caso
    // de acesso a documentos numa regra de escrita é perfil + membership +
    // workspace (status de arquivamento) + o documento do próprio domínio,
    // abaixo do teto de 10 por requisição avulsa e 20 por lote/transação.
    function accountStatus() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '');
    }

    function hasActiveAccount() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        accountStatus() == 'active';
    }

    function membershipPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }

    function isMember(workspaceId) {
      return hasActiveAccount() &&
        exists(membershipPath(workspaceId)) &&
        get(membershipPath(workspaceId)).data.get('status', '') == 'active';
    }

    function getRole(workspaceId) {
      return get(membershipPath(workspaceId)).data.role;
    }

    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && getRole(workspaceId) in roles;
    }

    // Workspace arquivado é somente leitura para os membros ativos: nenhuma
    // escrita do cliente é aceita, em nenhuma subcoleção.
    function isWorkspaceActive(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.get('status', '') == 'active';
    }

    function hasWriteRole(workspaceId, roles) {
      return hasRole(workspaceId, roles) && isWorkspaceActive(workspaceId);
    }

    function canReadWorkspaceScopedData(workspaceId) {
  return isMember(workspaceId);
}

function canWriteWorkspaceScopedData(workspaceId) {
  return hasWriteRole(workspaceId, ['owner', 'admin']);
}

function canMemberWriteWorkspaceScopedData(workspaceId) {
  return hasWriteRole(workspaceId, ['owner', 'admin', 'member']);
}

// Leitura do domínio patrimonial: `viewer` continua fora (matriz de
// investimentos inalterada em P1, D-02).
function canReadInvestmentDomain(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin', 'member']);
}

function canReadSensitiveInvestmentDomain(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin']);
}

// NOTA M4 — não existe validação de conteúdo em `list`.
//
// Regras não são filtros: numa consulta o Firestore precisa decidir a partir
// das restrições da própria query, sem documento concreto, então qualquer
// predicado sobre `resource.data` numa cláusula `list` é inavaliável e nega a
// consulta inteira — verificado no Emulator com documento bem formado.
//
// O isolamento de tenant na listagem é garantido pelo path: só se lista o que
// está sob `workspaces/{workspaceId}`. A coerência entre o campo
// `workspaceId` e o path é imposta na escrita, pelo backend
// (`assertInvestmentDocument`), que é a camada onde ela é exequível.
function isBoundedInvestmentList() {
  return request.query.limit != null &&
    request.query.limit > 0 &&
    request.query.limit <= 100;
}

function isInvestmentString(value, maxSize) {
  return value is string && value.size() > 0 && value.size() <= maxSize;
}

function isInvestmentProfileType(value) {
  return value in ['PF', 'PJ'];
}

function isInvestmentCurrency(value) {
  return value == 'BRL';
}

function isInvestmentInteger(value) {
  return value is int &&
    value >= -9007199254740991 && value <= 9007199254740991;
}

function isNonNegativeInvestmentInteger(value) {
  return isInvestmentInteger(value) && value >= 0;
}

function hasValidInvestmentIdentity(data, workspaceId, docId) {
  return data.id == docId &&
    data.workspaceId == workspaceId &&
    isInvestmentProfileType(data.profileType);
}

// P4-D (D-15): conta técnica da instituição, criada pelo primeiro
// investimento nela; sem arquivamento.
function isValidInvestmentAccount(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'name', 'institutionName',
      'institutionId', 'currency', 'status', 'createdBy', 'createdAt',
      'updatedBy', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.name, 160) &&
    isInvestmentString(data.institutionName, 160) &&
    isInvestmentString(data.institutionId, 160) &&
    isInvestmentCurrency(data.currency) &&
    data.status == 'active' &&
    isInvestmentString(data.createdBy, 128) &&
    isInvestmentString(data.updatedBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp;
}

function isValidInvestmentAsset(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'name', 'assetType', 'currency',
      'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.name, 160) &&
    isInvestmentString(data.assetType, 80) &&
    (!data.keys().hasAny(['allocationPurpose']) ||
      data.allocationPurpose in [
        'unassigned', 'retirement', 'goal', 'reserve',
        'financial_application', 'reinvestment', 'fixed_asset'
      ]) &&
    (!data.keys().hasAny(['allocationPurpose']) ||
      (data.profileType == 'PF' &&
        data.allocationPurpose in ['unassigned', 'retirement', 'goal']) ||
      (data.profileType == 'PJ' &&
        data.allocationPurpose in [
          'unassigned', 'reserve', 'financial_application',
          'reinvestment', 'fixed_asset'
        ])) &&
    (!data.keys().hasAny(['symbol']) || isInvestmentString(data.symbol, 32)) &&
    // P4-D (D-15): carteira de investimentos e categoria por catálogo
    // (`category`/`investimento`), fotografadas; regime único por valor.
    isInvestmentString(data.classId, 160) &&
    isInvestmentString(data.className, 160) &&
    isInvestmentString(data.typeId, 160) &&
    isInvestmentString(data.typeName, 160) &&
    data.trackingMode == 'value' &&
    isInvestmentCurrency(data.currency) &&
    data.status == 'active' &&
    isInvestmentString(data.createdBy, 128) &&
    isInvestmentString(data.updatedBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp;
}

function isValidInvestmentMovement(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'domainVersion',
      'calculationVersion', 'accountId', 'assetId', 'positionId',
      'operation', 'status', 'currency', 'description', 'principalCents',
      'gainCents', 'feesCents', 'taxCents', 'quantityMicros',
      'cashDeltaCents', 'principalDeltaCents', 'realizedGainDeltaCents',
      'feesDeltaCents', 'taxDeltaCents', 'quantityDeltaMicros',
      'goalNetContributionDeltaCents', 'goalCurrentValueDeltaCents',
      'correlationId', 'idempotencyKeyHash', 'occurredAt', 'createdBy',
      'createdAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    data.domainVersion == 2 &&
    isInvestmentString(data.calculationVersion, 100) &&
    isInvestmentString(data.accountId, 128) &&
    isInvestmentString(data.assetId, 128) &&
    isInvestmentString(data.positionId, 257) &&
    data.operation in ['contribution', 'redemption', 'reversal', 'goal_link', 'goal_unlink'] &&
    data.status in ['pending', 'settled', 'cancelled'] &&
    isInvestmentCurrency(data.currency) &&
    isInvestmentString(data.description, 500) &&
    isNonNegativeInvestmentInteger(data.principalCents) &&
    isNonNegativeInvestmentInteger(data.gainCents) &&
    // INV-P1-009 — perda realizada. Não-negativa como o ganho, e mutuamente
    // exclusiva com ele: o resultado com sinal é derivado.
    isNonNegativeInvestmentInteger(data.get('lossCents', 0)) &&
    (data.get('gainCents', 0) == 0 || data.get('lossCents', 0) == 0) &&
    isNonNegativeInvestmentInteger(data.feesCents) &&
    isNonNegativeInvestmentInteger(data.taxCents) &&
    isNonNegativeInvestmentInteger(data.quantityMicros) &&
    isInvestmentInteger(data.cashDeltaCents) &&
    isInvestmentInteger(data.principalDeltaCents) &&
    isInvestmentInteger(data.realizedGainDeltaCents) &&
    isInvestmentInteger(data.get('realizedLossDeltaCents', 0)) &&
    isInvestmentInteger(data.feesDeltaCents) &&
    isInvestmentInteger(data.taxDeltaCents) &&
    isInvestmentInteger(data.quantityDeltaMicros) &&
    isInvestmentInteger(data.goalNetContributionDeltaCents) &&
    isInvestmentInteger(data.goalCurrentValueDeltaCents) &&
    // Etapa 1 — rótulos fotografados na escrita, para a listagem simples não
    // precisar de uma leitura por linha. Opcionais no contrato do movimento
    // (`documentContracts.ts`): o vínculo de meta não os fotografa.
    data.get('institutionId', 'x') is string &&
    data.get('institutionName', 'x') is string &&
    data.get('classId', 'x') is string &&
    data.get('className', 'x') is string &&
    data.get('typeId', 'x') is string &&
    data.get('typeName', 'x') is string &&
    data.get('assetName', 'x') is string &&
    // P4-D (D-30) — conta do Caixa e movimento de conta do fato liquidado
    // com dinheiro; ausentes em pendente, cancelado e vínculo de meta.
    (
      (data.status == 'settled' &&
        data.operation in ['contribution', 'redemption', 'reversal'] &&
        isInvestmentString(data.get('cashAccountId', ''), 240) &&
        isInvestmentString(data.get('accountMovementId', ''), 240)) ||
      (!(data.status == 'settled' &&
          data.operation in ['contribution', 'redemption', 'reversal']) &&
        !data.keys().hasAny(['cashAccountId', 'accountMovementId']))
    ) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.idempotencyKeyHash, 128) &&
    data.occurredAt is timestamp && data.createdAt is timestamp &&
    isInvestmentString(data.createdBy, 128) &&
    (!data.keys().hasAny(['settlementAt']) || data.settlementAt is timestamp) &&
    (!data.keys().hasAny(['settledAt']) || data.settledAt is timestamp) &&
    (!data.keys().hasAny(['settledBy']) || isInvestmentString(data.settledBy, 128)) &&
    (
      (data.status == 'pending' &&
        hasZeroInvestmentMovementDeltas(data) &&
        !data.keys().hasAny(['settledAt', 'settledBy'])) ||
      (data.status == 'cancelled' &&
        hasZeroInvestmentMovementDeltas(data) &&
        !data.keys().hasAny(['settledAt', 'settledBy']) &&
        data.cancelledAt is timestamp &&
        isInvestmentString(data.cancelledBy, 128)) ||
      (data.status == 'settled' && data.settlementAt is timestamp &&
        data.settledAt is timestamp && isInvestmentString(data.settledBy, 128))
    );
}

function hasZeroInvestmentMovementDeltas(data) {
  return data.cashDeltaCents == 0 && data.principalDeltaCents == 0 &&
    data.realizedGainDeltaCents == 0 &&
    data.get('realizedLossDeltaCents', 0) == 0 &&
    data.feesDeltaCents == 0 &&
    data.taxDeltaCents == 0 && data.quantityDeltaMicros == 0 &&
    data.goalNetContributionDeltaCents == 0 &&
    data.goalCurrentValueDeltaCents == 0;
}

function isValidInvestmentPosition(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'accountId', 'assetId', 'currency',
      'status', 'quantityMicros', 'principalCents', 'realizedGainCents',
      'feesCents', 'taxCents', 'currentValueCents',
      'unrealizedAppreciationCents', 'calculationVersion', 'version',
      'createdAt', 'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.accountId, 128) &&
    isInvestmentString(data.assetId, 128) &&
    isInvestmentCurrency(data.currency) &&
    data.status == 'active' &&
    isNonNegativeInvestmentInteger(data.quantityMicros) &&
    isNonNegativeInvestmentInteger(data.principalCents) &&
    isNonNegativeInvestmentInteger(data.realizedGainCents) &&
    isNonNegativeInvestmentInteger(data.get('realizedLossCents', 0)) &&
    // INV-P1-009 — invariante de encerramento: sem quantidade não há custo de
    // aquisição a sustentar. Principal remanescente com quantidade zero é
    // patrimônio fantasma, e a reconstrução o reproduz.
    (data.quantityMicros > 0 || data.principalCents == 0) &&
    isNonNegativeInvestmentInteger(data.feesCents) &&
    isNonNegativeInvestmentInteger(data.taxCents) &&
    isNonNegativeInvestmentInteger(data.currentValueCents) &&
    isInvestmentInteger(data.unrealizedAppreciationCents) &&
    isInvestmentString(data.calculationVersion, 100) &&
    isNonNegativeInvestmentInteger(data.version) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

function isValidInvestmentEventLog(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'actorId', 'actorRole',
      'operation', 'entityType', 'entityId', 'correlationId',
      'idempotencyKeyId', 'outcome', 'details', 'occurredAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.actorId, 128) &&
    data.actorRole in ['owner', 'admin', 'member'] &&
    isInvestmentString(data.operation, 128) &&
    data.entityType in [
      'account', 'asset', 'movement', 'position', 'goal', 'snapshot',
      'importBatch'
    ] &&
    isInvestmentString(data.entityId, 257) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.idempotencyKeyId, 257) &&
    data.outcome == 'completed' && data.details is map &&
    data.occurredAt is timestamp;
}

// Evento de falha: gravado fora da transação de negócio, que já abortou, e
// por isso sem `profileType`/`actorRole` — não há leitura de workspace nem de
// membership disponível nesse ponto.
function isValidInvestmentFailureEventLog(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'operation', 'entityType', 'entityId',
      'outcome', 'details', 'occurredAt'
    ]) &&
    data.workspaceId == workspaceId && data.id == docId &&
    isInvestmentString(data.operation, 128) &&
    data.entityType == 'operation' &&
    isInvestmentString(data.entityId, 257) &&
    data.outcome == 'failed' && data.details is map &&
    data.occurredAt is timestamp;
}

function isValidInvestmentReportPeriod(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'currency', 'period',
      'periodStart', 'contributionCents', 'redemptionPrincipalCents',
      'realizedGainCents', 'feesCents', 'taxCents', 'costDeltaCents',
      'currentValueDeltaCents', 'cashDeltaCents', 'settledMovementCount',
      'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentCurrency(data.currency) &&
    data.period is string &&
    data.period == docId &&
    data.period.matches('^\\d{4}-\\d{2}$') &&
    data.periodStart is timestamp &&
    isInvestmentInteger(data.contributionCents) &&
    isInvestmentInteger(data.redemptionPrincipalCents) &&
    isInvestmentInteger(data.realizedGainCents) &&
    isInvestmentInteger(data.get('realizedLossCents', 0)) &&
    isInvestmentInteger(data.feesCents) &&
    isInvestmentInteger(data.taxCents) &&
    isInvestmentInteger(data.costDeltaCents) &&
    isInvestmentInteger(data.currentValueDeltaCents) &&
    isInvestmentInteger(data.cashDeltaCents) &&
    isInvestmentInteger(data.settledMovementCount) &&
    (!data.keys().hasAny(['daily']) || data.daily is map) &&
    data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

function isValidInvestmentAllocationSummary(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'currency', 'dimension', 'key',
      'label', 'positionCount', 'principalCents', 'currentValueCents',
      'realizedGainCents', 'feesCents', 'taxCents', 'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentCurrency(data.currency) &&
    data.dimension in [
      'account', 'class', 'asset', 'goal', 'risk', 'liquidity',
      'indexer', 'purpose'
    ] &&
    isInvestmentString(data.key, 257) &&
    isInvestmentString(data.label, 160) &&
    isInvestmentInteger(data.positionCount) &&
    isInvestmentInteger(data.principalCents) &&
    isInvestmentInteger(data.currentValueCents) &&
    isInvestmentInteger(data.realizedGainCents) &&
    isInvestmentInteger(data.get('realizedLossCents', 0)) &&
    isInvestmentInteger(data.feesCents) &&
    isInvestmentInteger(data.taxCents) &&
    data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

// Coleções cuja escrita é exclusiva do backend/Admin SDK e cuja leitura é
// governada por um bloco `match` próprio. Derivada de prefixo, e não de uma
// enumeração mantida à mão: uma coleção nova do domínio nasce negada no
// catch-all em vez de herdar leitura de qualquer membro.
function isBackendOwnedCollection(collectionName) {
  return collectionName.matches('^(investment_|credit_card_|goal_|recurring_|split_).*') ||
    collectionName in [
      // P4-A (D-36) — o cadastro do cartão também é só do backend (o prefixo
      // `credit_card_` não alcança `credit_cards`); leitura pelo bloco
      // próprio, com teto de listagem.
      'credit_cards',
      // P1 — membership, convites e auditoria têm bloco próprio, com teto de
      // listagem e papel. Sem estas linhas a regra genérica de subcoleção
      // concederia listagem irrestrita a qualquer membro (e a `viewer`), e no
      // Firestore basta uma regra conceder para o acesso passar.
      'members',
      'invites',
      'membership_events',
      // P3-A — auditoria do caixa, com bloco próprio pelo mesmo motivo.
      'cash_events',
      // P3-G — auditoria de empréstimos, idem.
      'loan_events',
      // P3-I (D-24) — dados pessoais de clientes e auditoria de clientes e
      // recebíveis: só owner/admin, pelo bloco próprio. Fora desta lista a
      // catch-all entregaria documento, e-mail e telefone a member e viewer.
      'client_private',
      'client_events',
      'receivable_events',
      // P3-J (D-30) — contas, livro-razão das contas, transferências e a
      // auditoria delas têm bloco próprio (leitura com teto de listagem;
      // auditoria só owner/admin). Fora desta lista a catch-all concederia
      // listagem sem limite a qualquer membro.
      'cash_accounts',
      'cash_account_movements',
      'cash_transfers',
      'cash_account_events',
      // Contadores de limite de frequência: estado operacional server-only.
      // Expor a contagem ao cliente entrega o orçamento restante a quem
      // estiver tentando forçar o limite.
      'rate_limits',
      // Projeção mensal de caixa. Precisa estar aqui **mesmo tendo regra
      // própria**: a regra catch-all de subcoleção concede leitura a qualquer
      // membro, e no Firestore basta uma regra conceder para o acesso passar.
      // Sem esta linha, o teto de 600 documentos da regra específica era
      // contornado pela catch-all, e uma listagem ilimitada reintroduzia o
      // custo linear que a projeção existe para eliminar.
      'cash_report_periods',
      // P2B.1 — estado de quota do workspace (membros ativos e reservas de
      // convite): server-only nos dois sentidos. Fora desta lista a regra
      // catch-all daria leitura a qualquer membro. O equivalente do titular
      // (`billing_accounts/{uid}/quota_state`) já é negado pela regra
      // curinga de `billing_accounts`.
      'quota_state',
      // INV-P3-001 — marca de entrega do gatilho de caixa. É o que impede a
      // reentrega do mesmo evento de somar o delta duas vezes. Um cliente que
      // conseguisse criá-la faria o gatilho legítimo pular a aplicação e o
      // saldo do workspace ficaria para trás; um cliente que conseguisse
      // apagá-la reabriria a duplicação. Server-only nos dois sentidos.
      'cash_period_events',
      // P4-E (D-23) — catálogo de configurações: leitura pelo bloco próprio,
      // com teto de listagem; reservas de nome e auditoria fechadas. Fora
      // desta lista a catch-all concederia listagem sem limite a qualquer
      // membro, e leitura das reservas e da auditoria.
      'settings_catalog',
      'settings_catalog_uniques',
      'settings_catalog_events'
    ];
}

    match /workspaces/{workspaceId} {
      // P1 — o workspace é server-owned. Criação, configurações,
      // arquivamento e transferência de titularidade passam pelas callables
      // do kernel (`createWorkspace`, `updateWorkspaceSettings`,
      // `archiveWorkspace`, `transferWorkspaceOwnership`); o cliente não grava
      // o documento. Um workspace arquivado continua legível pelos membros
      // ativos e não aceita escrita em nenhuma subcoleção.
      allow read: if isMember(workspaceId);
      allow create, update, delete: if false;

      // Membership: única fonte de papel, gravada só pelo backend (convite,
      // aceite, troca de papel, remoção lógica, saída, transferência). O
      // próprio usuário lê o seu documento — é como a interface descobre o
      // papel e percebe uma remoção; os membros ativos listam os demais com
      // teto por página.
      match /members/{memberId} {
        allow get: if
          (hasActiveAccount() && memberId == request.auth.uid) ||
          isMember(workspaceId);
        allow list: if isMember(workspaceId) && request.query.limit <= 200;
        allow write: if false;
      }

      // Convites (D-05): owner e admin acompanham os convites do workspace.
      // O documento não guarda o token nem o seu hash (o ponteiro do hash
      // fica em `invite_tokens`, que o cliente não alcança).
      match /invites/{inviteId} {
        allow get: if hasRole(workspaceId, ['owner', 'admin']);
        allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
          request.query.limit <= 100;
        allow write: if false;
      }

      // Auditoria append-only de workspace e membership: leitura por owner e
      // admin, escrita só pelo backend na mesma transação da mudança.
      match /membership_events/{eventId} {
        allow get: if hasRole(workspaceId, ['owner', 'admin']);
        allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
          request.query.limit <= 100;
        allow write: if false;
      }

      // P3-A — auditoria append-only do caixa: mesmo contrato de
      // `membership_events`. O evento não copia valor nem descrição; o fato
      // vive no lançamento, que nunca é apagado.
      match /cash_events/{eventId} {
        allow get: if hasRole(workspaceId, ['owner', 'admin']);
        allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
          request.query.limit <= 100;
        allow write: if false;
      }

      // P4-D (D-15) — `transactions` é escrita exclusivamente pelo backend
      // (Admin SDK): lançamento manual e importação (P3), espelhos de
      // empréstimo, recebível, pagamento de fatura, Divisão de contas,
      // Recorrentes e investimento, todos com a marca do domínio e o
      // movimento de conta (D-30). O caminho de escrita direta do cliente
      // acabou — criação, correção, anulação e baixa lógica são callables
      // autoritativas. O cliente não cria nenhum tipo (inclusive
      // `investimento`), não edita nem anula espelho e não apaga histórico.
      // Leitura: todo membro ativo (inclusive viewer).
      match /transactions/{docId} {
        allow read: if isMember(workspaceId);
        allow create, update, delete: if false;
      }

      // P4-B (D-12) — despesas recorrentes autoritativas. Toda escrita é do
      // backend (callables com Admin SDK e o agendador): contrato, ocorrências
      // e trilha. O cliente não grava estado, próximo vencimento, ocorrência,
      // fato gerado nem histórico de valores (PR-REC-01). Leitura: todo membro
      // ativo (inclusive viewer), com teto de listagem; a trilha também, porque
      // dela sai o histórico de valores da tela (só números, estados, datas e
      // IDs — nenhum texto livre).
      match /recurring_expenses/{docId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 501;
        allow create, update, delete: if false;
      }

      match /recurring_occurrences/{docId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 101;
        allow create, update, delete: if false;
      }

      match /recurring_events/{eventId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 50;
        allow create, update, delete: if false;
      }

      // P4-A (D-36) — cartões de crédito autoritativos. Toda escrita é do
      // backend (callables com Admin SDK, transação, idempotência e
      // auditoria): cadastro, compras, parcelas e lançamentos de fatura,
      // faturas, pagamentos, livro do limite e eventos. O cliente não forja
      // nenhum campo — nem o cadastro do cartão, que antes era gravado
      // diretamente. Leitura: todo membro ativo (inclusive viewer) lê o
      // domínio, com teto de listagem (o +1 sobre 500 é a sonda que o
      // frontend usa para sinalizar corte em vez de truncar em silêncio); a
      // auditoria é só de owner/admin.
      match /credit_cards/{cardId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 50;
        allow create, update, delete: if false;
      }

      match /credit_card_purchases/{purchaseId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 501;
        allow create, update, delete: if false;
      }

      match /credit_card_invoices/{invoiceId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 501;
        allow create, update, delete: if false;
      }

      match /credit_card_invoice_entries/{entryId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 501;
        allow create, update, delete: if false;
      }

      match /credit_card_invoice_payments/{paymentId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 501;
        allow create, update, delete: if false;
      }

      match /credit_card_limit_ledger/{entryId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit <= 201;
        allow create, update, delete: if false;
      }

      match /credit_card_events/{eventId} {
        allow get: if hasRole(workspaceId, ['owner', 'admin']);
        allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
          request.query.limit <= 50;
        allow create, update, delete: if false;
      }

      match /goals/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if false;
      }

      match /goal_audit_logs/{docId} {
        allow read: if canWriteWorkspaceScopedData(workspaceId);
        allow write: if false;
      }

      match /goal_idempotency_keys/{docId} {
        allow read, write: if false;
      }

      match /investment_accounts/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAccount(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_assets/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAsset(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_movements/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentMovement(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_positions/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentPosition(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_event_logs/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) && (
          isValidInvestmentEventLog(resource.data, workspaceId, docId) ||
          isValidInvestmentFailureEventLog(resource.data, workspaceId, docId)
        );
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_operational_metrics/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) &&
          resource.data.workspaceId == workspaceId &&
          resource.data.id == docId &&
          resource.data.domain == 'investment' &&
          resource.data.status in ['success', 'failure'] &&
          isInvestmentString(resource.data.operation, 128) &&
          isNonNegativeInvestmentInteger(resource.data.count) &&
          resource.data.updatedAt is timestamp;
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      // INV-P1-011 — projeção mensal de caixa. Escrita exclusiva do gatilho de
      // transações e da reconstrução; leitura por qualquer membro, porque é o
      // que substitui a varredura da coleção inteira de transações.
      match /cash_report_periods/{docId} {
        allow get: if canReadWorkspaceScopedData(workspaceId);
        allow list: if canReadWorkspaceScopedData(workspaceId) &&
          request.query.limit != null &&
          request.query.limit > 0 &&
          request.query.limit <= 600;
        allow write: if false;
      }

      // INV-P3-001 — marca de entrega do gatilho de caixa. Escrita e leitura
      // exclusivas do Admin SDK: o cliente não pode nem conferir nem forjar a
      // marca que decide se um delta financeiro é aplicado.
      match /cash_period_events/{docId} {
        allow read, write: if false;
      }

      // Relatório de deriva (INV-P2-019): estado operacional server-only, lido
      // por owner/admin para diagnóstico.
      match /investment_drift_reports/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId);
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_idempotency_keys/{docId} {
        allow read, write: if false;
      }

      match /investment_summaries/{docId} {
  allow get: if docId == 'current' &&
    canReadInvestmentDomain(workspaceId) &&
    (
      !exists(
        /databases/$(database)/documents/workspaces/$(workspaceId)/investment_summaries/$(docId)
      ) ||
      (
        resource.data.workspaceId == workspaceId &&
        resource.data.id == docId &&
        isInvestmentProfileType(resource.data.profileType) &&
        resource.data.currency == 'BRL' &&
        isNonNegativeInvestmentInteger(resource.data.positionCount) &&
        isNonNegativeInvestmentInteger(resource.data.principalCents) &&
        isNonNegativeInvestmentInteger(resource.data.currentValueCents) &&
        isNonNegativeInvestmentInteger(resource.data.realizedGainCents) &&
        isNonNegativeInvestmentInteger(
          resource.data.get('realizedLossCents', 0)) &&
        isNonNegativeInvestmentInteger(resource.data.feesCents) &&
        isNonNegativeInvestmentInteger(resource.data.taxCents) &&
        resource.data.unrealizedAppreciationCents is int &&
        resource.data.updatedAt is timestamp
      )
    );
  allow list, write: if false;
}

      // P4-D (D-15) — o card "Investimentos" do dashboard lê o aporte do mês
      // desta projeção (antes somado do espelho em `transactions`, que todo
      // membro lê). Por isso a leitura do agregado mensal é de todo membro
      // ativo, viewer incluído; posições, movimentos e ativos continuam fora
      // do viewer (`canReadInvestmentDomain`).
      match /investment_report_periods/{docId} {
        allow get: if isMember(workspaceId) &&
          isValidInvestmentReportPeriod(resource.data, workspaceId, docId);
        allow list: if isMember(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_allocation_summaries/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAllocationSummary(
            resource.data,
            workspaceId,
            docId
          );
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      // P3-H — empréstimos só pelo backend (D-13): `createLoan`,
      // `registerLoanPayment`, `reverseLoanMovement`, `cancelLoan` e
      // `updateLoanMetadata` (Admin SDK) são o único caminho de escrita. O
      // cliente lê conforme o papel e não cria, altera nem apaga nada aqui —
      // nenhum papel, nenhuma exceção.
      match /loans/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow create, update, delete: if false;
}

match /loan_movements/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow create, update, delete: if false;
}

// P3-G — auditoria append-only do domínio de empréstimos (sem dados da
// contraparte). Mesmo regime de `cash_events`.
match /loan_events/{eventId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 100;
  allow write: if false;
}

// P3-I — clientes e recebíveis só pelo backend (D-24, D-39): as callables
// `createClient`, `updateClient`, `archiveClient`, `createReceivable`,
// `updateReceivable`, `receiveReceivable`, `reverseReceivableReceipt` e
// `cancelReceivable` (Admin SDK) são o único caminho de escrita. O cliente
// não cria, altera nem apaga nada nestas coleções — nenhum papel.
//
// `clients` guarda só o compartilhado (nome e estado), lido por qualquer
// membro ativo. Os dados pessoais (documento, e-mail, telefone, endereço e
// observações) ficam em `client_private`, que só owner e admin leem: member
// e viewer não recebem esses campos do Firestore.
match /clients/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow create, update, delete: if false;
}

match /client_private/{docId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 100;
  allow create, update, delete: if false;
}

match /receivables/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow create, update, delete: if false;
}

match /receivable_movements/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow create, update, delete: if false;
}

// Auditoria append-only (sem PII), mesmo regime de `loan_events`.
match /client_events/{eventId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 100;
  allow write: if false;
}

match /receivable_events/{eventId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 100;
  allow write: if false;
}

// P3-J (D-30) — contas/carteiras, livro-razão das contas e transferências.
// Escrita só pelo backend (callables com Admin SDK): o cliente não cria
// conta, não altera `balanceCents`, não cria movimento nem transferência e
// não forja a origem de um movimento. Leitura por qualquer membro ativo
// (viewer incluído, só leitura), com teto de listagem — as consultas do
// produto pedem página com limite explícito.
match /cash_accounts/{accountId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 100;
  allow create, update, delete: if false;
}

match /cash_account_movements/{movementId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 100;
  allow create, update, delete: if false;
}

match /cash_transfers/{transferId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 100;
  allow create, update, delete: if false;
}

match /cash_account_events/{eventId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 100;
  allow write: if false;
}

match /notifications/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);

  allow create: if false;

  allow update: if
    canReadWorkspaceScopedData(workspaceId) &&
    isWorkspaceActive(workspaceId) &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
    request.resource.data.read is bool;

  allow delete: if canWriteWorkspaceScopedData(workspaceId);
}

// P4-C (D-14) — Divisão de contas autoritativa. Toda escrita é do backend
// (callables com Admin SDK, transação, idempotência e auditoria): grupos,
// participantes, convites, títulos, rateios, reembolsos e trilha. O cliente
// não grava dono, papel, estado, valores, rateios, quitação nem vínculo
// financeiro (PR-SPLIT-01, PR-SPLIT-02, PR-RULES-01). Leitura: todo membro
// ativo do workspace (inclusive viewer) lê o domínio, com teto de listagem
// (o +1 é a sonda de corte do frontend). O convite guarda só o hash do
// código e é lido por owner/admin ou por quem o criou; a trilha, só por
// owner/admin.
match /split_groups/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 101;
  allow create, update, delete: if false;
}

match /split_participants/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 101;
  allow create, update, delete: if false;
}

match /split_invites/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId) &&
    (hasRole(workspaceId, ['owner', 'admin']) ||
      resource.data.createdBy == request.auth.uid);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 21 &&
    (hasRole(workspaceId, ['owner', 'admin']) ||
      resource.data.createdBy == request.auth.uid);
  allow create, update, delete: if false;
}

match /split_bills/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 101;
  allow create, update, delete: if false;
}

match /split_shares/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 51;
  allow create, update, delete: if false;
}

match /split_reimbursements/{docId} {
  allow get: if canReadWorkspaceScopedData(workspaceId);
  allow list: if canReadWorkspaceScopedData(workspaceId) &&
    request.query.limit <= 101;
  allow create, update, delete: if false;
}

match /split_events/{eventId} {
  allow get: if hasRole(workspaceId, ['owner', 'admin']);
  allow list: if hasRole(workspaceId, ['owner', 'admin']) &&
    request.query.limit <= 50;
  allow create, update, delete: if false;
}

      // P4-E (D-23) — catálogo de configurações backend-authoritative.
      // Criar, editar (renomear, aparência, reativar) e inativar passam só
      // pelas callables `createSettingsCatalogItem`,
      // `updateSettingsCatalogItem` e `archiveSettingsCatalogItem`, que
      // derivam escopo, nome normalizado e chave de unicidade e gravam item,
      // reserva e auditoria na mesma transação. Todo membro ativo lê (os
      // seletores de lançamento de todos os papéis dependem do catálogo),
      // com teto de listagem: 2.001 cobre a leitura completa do frontend
      // (`SETTINGS_CATALOG_READ_LIMIT` + 1), que o teto de itens do backend
      // mantém inteira. Nenhuma escrita do cliente, de nenhum papel.
      match /settings_catalog/{docId} {
        allow get: if isMember(workspaceId);
        allow list: if isMember(workspaceId) && request.query.limit <= 2001;
        allow create, update, delete: if false;
      }

      // Reservas de nome (unicidade) e auditoria do catálogo: estado interno
      // do backend, sem consumidor no cliente. Fechadas nos dois sentidos —
      // um membro não lê nem forja reserva, `catalogItemId`, `dedupeKey` ou
      // autoria.
      match /settings_catalog_uniques/{lockId} {
        allow read, write: if false;
      }

      match /settings_catalog_events/{eventId} {
        allow read, write: if false;
      }

          match /{subCollection}/{docId} {
        allow read: if
          !isBackendOwnedCollection(subCollection) &&
          canReadWorkspaceScopedData(workspaceId);

        allow write: if false;
      }
    }

    // P1 — perfil server-owned. `bootstrapAccount` cria o perfil a partir do
    // token verificado; `status` (suspensão) e `isAdmin` são gravados só pelo
    // backend (Admin SDK). Plano e cobrança não vivem aqui: o estado canônico
    // é `billing_accounts/{uid}` (P2A). O cliente não tem
    // mais nenhum caminho de escrita aqui: a allowlist anterior (INV-P1-013)
    // deixava o próprio usuário reescrever `email` e campos de exibição que
    // agora vêm do token.
    match /users/{userId} {
      // O próprio usuário lê o perfil mesmo suspenso: é como a interface
      // descobre o status da conta.
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;

      // Contadores de limite de frequência do usuário: server-only nos dois
      // sentidos. Expor a contagem entrega o orçamento restante a quem
      // estiver tentando forçá-lo.
      match /rate_limits/{docId} {
        allow read, write: if false;
      }

      // Chaves de idempotência das callables do kernel: server-only.
      match /idempotency_keys/{docId} {
        allow read, write: if false;
      }

      // P2B.2 — recibos de consumo de crédito de IA, sob quem enviou a
      // chave (a idempotência é do ator; o crédito, do titular). Só
      // metadados e hash; server-only nos dois sentidos: nem o próprio
      // usuário lê, lista ou grava. Nenhuma regra de collection group
      // (`{path=**}`) alcança esta coleção.
      match /ai_usage_receipts/{receiptId} {
        allow read, write: if false;
      }

      // Índice de participação: listagem da interface, gravado só pelo
      // backend na mesma transação que altera o membership. Não tem papel e
      // não autoriza nada; o papel é lido de `workspaces/{id}/members/{uid}`.
      match /workspaces/{workspaceId} {
        allow get: if hasActiveAccount() && request.auth.uid == userId;
        allow list: if hasActiveAccount() && request.auth.uid == userId &&
          request.query.limit <= 50;
        allow write: if false;
      }
    }

    // P2A — estado canônico de billing (D-01): um documento por titular da
    // assinatura, gravado só pelo backend (bootstrap, checkout e webhook).
    // O titular ativo lê o próprio estado para a interface; não há `list`
    // (nenhuma enumeração de titulares), leitura cruzada nem escrita do
    // cliente — plano, status e entitlement nunca são graváveis daqui.
    match /billing_accounts/{billingOwnerUid} {
      allow get: if hasActiveAccount() && request.auth.uid == billingOwnerUid;
      allow list, create, update, delete: if false;

      // Trilha append-only de billing, estado de quota (P2B.1) e uso mensal
      // de créditos de IA do titular (P2B.2: `ai_usage/{YYYY-MM}`):
      // backend-only nos dois sentidos, sem leitura nem listagem nem para o
      // próprio titular. Nenhuma regra de collection group (`{path=**}`)
      // alcança essas coleções.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Vínculo customer do Stripe → titular e recibos idempotentes do
    // webhook: coleções internas, backend-only nos dois sentidos.
    match /billing_customers/{stripeCustomerId} {
      allow read, write: if false;
    }

    match /billing_webhook_events/{stripeEventId} {
      allow read, write: if false;
    }
  }
}
