rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        (
          !get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.keys().hasAny(['status']) ||
          get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status == 'active'
        );
    }

    function getRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && getRole(workspaceId) in roles;
    }

    // Para subcoleções: lê o ownerId do documento pai
    function isWorkspaceOwnerByParent(workspaceId) {
      return signedIn() &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid &&
        (
          !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) ||
          isMember(workspaceId)
        );
    }

    function isDateOnlyString(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidTransactionType(value) {
      return value in ['receita', 'despesa', 'investimento', 'parcelado'];
    }

    // Trilha legada de investimento, fechada quando o domínio oficial está
    // ligado. Com a flag ativa os relatórios leem só as projeções, mas o fluxo
    // de caixa continua somando `transactions`: um aporte gravado direto pelo
    // cliente sairia do caixa e nunca chegaria ao patrimônio. O backend impõe
    // o mesmo em `assertLegacyInvestmentTrailOpen`; aqui fecha-se a escrita
    // direta, que não passa por callable nenhuma.
    //
    // O `get()` só é avaliado quando o tipo é `investimento`, porque `&&`
    // curto-circuita — receita, despesa e parcelado não pagam a leitura.
    function investmentsV2Enabled(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId))
        .data.get('features', {})
        .get('investmentsV2', {})
        .get('enabled', false) == true;
    }

    function isLegacyInvestmentWriteAllowed(workspaceId, data) {
      return data.type != 'investimento' || !investmentsV2Enabled(workspaceId);
    }

    // M4.A — superfície de escrita do cliente em `transactions`, fechada.
//
// `isCommonValidTransactionPayload` é verificação de tipo em mundo aberto: sem
// `hasAll` e sem `hasOnly`, aceitava qualquer chave extra. Isso deixava o
// cliente gravar campos autoritativos do backend, com destaque para
// `valueCents` — o valor em centavos que o domínio de investimentos considera
// oficial e que o frontend nunca escreve.
function hasOnlyClientTransactionKeys(data) {
  return data.keys().hasOnly([
    'type', 'description', 'category', 'value', 'date', 'transactionDate',
    'installments', 'currentInstallment', 'cardId', 'walletId', 'userId',
    'workspaceId', 'profileId', 'loanId', 'loanMovementId', 'expenseType',
    'incomeType', 'paymentMethod', 'isPaid', 'supplier', 'costCenter',
    'source', 'creditCardInvoiceId', 'creditCardInvoicePaymentId',
    'creditCardCompatibility', 'displaySnapshots', 'createdAt', 'updatedAt'
  ]);
}

// Campos que o cliente pode alterar numa transação já existente. O que ficar
// de fora é imutável por construção — inclusive `workspaceId`, `userId`,
// `profileId` e `createdAt`, e qualquer campo que só o backend grave.
function changesOnlyMutableTransactionKeys() {
  return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
    'type', 'description', 'category', 'value', 'date', 'transactionDate',
    'installments', 'currentInstallment', 'cardId', 'walletId',
    'loanId', 'loanMovementId', 'expenseType', 'incomeType', 'paymentMethod',
    'isPaid', 'supplier', 'costCenter', 'source', 'creditCardInvoiceId',
    'creditCardInvoicePaymentId', 'creditCardCompatibility',
    'displaySnapshots', 'updatedAt'
  ]);
}

function isWorkspaceRoleName(value) {
  return value in ['owner', 'admin', 'member', 'viewer'];
}

function isCommonValidTransactionPayload(data, workspaceId) {
      return isValidTransactionType(data.type)
        && data.description is string
        && data.description.size() > 0
        && data.category is string
        && data.category.size() > 0
        && (data.value is int || data.value is float)
        && data.value > 0
        && isDateOnlyString(data.date)
        && data.userId is string
        && data.userId.size() > 0
        && (!data.keys().hasAny(['workspaceId']) || data.workspaceId == workspaceId)
        && (!data.keys().hasAny(['cardId']) || data.cardId is string)
        && (!data.keys().hasAny(['goalId']) || data.goalId is string)
        && (!data.keys().hasAny(['walletId']) || data.walletId is string || data.walletId is int || data.walletId is float)
        && (!data.keys().hasAny(['profileId']) || data.profileId is string)
        && (!data.keys().hasAny(['expenseType']) || data.expenseType is string)
        && (!data.keys().hasAny(['incomeType']) || data.incomeType is string)
        && (!data.keys().hasAny(['paymentMethod']) || data.paymentMethod is string)
        && (!data.keys().hasAny(['isPaid']) || data.isPaid is bool)
        && (!data.keys().hasAny(['supplier']) || data.supplier is string)
        && (!data.keys().hasAny(['costCenter']) || data.costCenter is string)
        && (!data.keys().hasAny(['installments']) || (data.installments is int && data.installments > 0))
        && (!data.keys().hasAny(['currentInstallment']) || (data.currentInstallment is int && data.currentInstallment > 0));
    }

    function isMemberTransactionOwner(workspaceId, data) {
      return hasRole(workspaceId, ['member']) && data.userId == request.auth.uid;
    }

    function canManageWorkspaceCatalog(workspaceId) {
      return hasRole(workspaceId, ['owner', 'admin']) || isWorkspaceOwnerByParent(workspaceId);
    }

    function isValidCatalogGroup(value) {
      return value in [
        'product_service',
        'expense_type',
        'category',
        'payment_method',
        'income_type',
        'wallet',
        'cost_center',
        'investment_type',
        'investment_class',
        'investment_risk',
        'investment_liquidity',
        'investment_indexer',
        'investment_strategy'
      ];
    }

    function isValidCatalogStatus(value) {
      return value in ['active', 'inactive'];
    }

    function isValidCatalogWorkspaceScope(value) {
      return value in ['PF', 'PJ', 'both'];
    }

    function isValidCatalogColor(value) {
      return value is string && value.matches('^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$');
    }

    function hasOnlyCatalogKeys(data) {
      return data.keys().hasOnly([
        'workspaceId',
        'group',
        'name',
        'normalizedName',
        'dedupeKey',
        'workspaceScope',
        'transactionSubtype',
        'icon',
        'color',
        'stroke',
        'sortOrder',
        'status',
        'createdBy',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isCatalogSubtypeConsistent(data) {
      return (
        (data.group == 'category' &&
          data.keys().hasAny(['transactionSubtype']) &&
          isValidTransactionType(data.transactionSubtype)
        ) ||
        (data.group != 'category' &&
          !data.keys().hasAny(['transactionSubtype'])
        )
      );
    }

    function isCatalogWorkspaceScopeConsistent(data, workspaceId) {
      return (
        (data.group == 'cost_center' && data.workspaceScope == 'PJ') ||
        (data.group in ['investment_class', 'investment_strategy'] &&
          data.workspaceScope == get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.type) ||
        (!(data.group in ['cost_center', 'investment_class', 'investment_strategy']) && data.workspaceScope == 'both')
      );
    }

    function isValidCatalogPayload(data, workspaceId) {
      return hasOnlyCatalogKeys(data)
        && data.workspaceId == workspaceId
        && isValidCatalogGroup(data.group)
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.normalizedName is string
        && data.normalizedName.size() > 0
        && data.dedupeKey is string
        && data.dedupeKey.size() > 0
        && isValidCatalogWorkspaceScope(data.workspaceScope)
        && isCatalogWorkspaceScopeConsistent(data, workspaceId)
        && isCatalogSubtypeConsistent(data)
        && (!data.keys().hasAny(['icon']) || data.icon is string)
        && (!data.keys().hasAny(['color']) || isValidCatalogColor(data.color))
        && (!data.keys().hasAny(['stroke']) || ((data.stroke is int || data.stroke is float) && data.stroke >= 1 && data.stroke <= 4))
        && (data.sortOrder is int || data.sortOrder is float)
        && isValidCatalogStatus(data.status)
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogCreate(data, workspaceId) {
      return canManageWorkspaceCatalog(workspaceId)
        && isValidCatalogPayload(data, workspaceId)
        && data.createdBy == request.auth.uid
        && data.updatedBy == request.auth.uid;
    }

    function isValidCatalogUpdate(data, previous, workspaceId) {
      return canManageWorkspaceCatalog(workspaceId)
        && isValidCatalogPayload(data, workspaceId)
        && data.workspaceId == previous.workspaceId
        && data.group == previous.group
        && data.workspaceScope == previous.workspaceScope
        && data.createdBy == previous.createdBy
        && data.createdAt == previous.createdAt
        && (
          (!previous.keys().hasAny(['transactionSubtype']) && !data.keys().hasAny(['transactionSubtype'])) ||
          (previous.keys().hasAny(['transactionSubtype']) && data.transactionSubtype == previous.transactionSubtype)
        )
        && data.updatedBy == request.auth.uid;
    }

    function hasOnlyCatalogUniqueKeys(data) {
      return data.keys().hasOnly([
        'dedupeKey',
        'catalogItemId',
        'workspaceId',
        'group',
        'normalizedName',
        'createdBy',
        'updatedBy',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidCatalogUniquePayload(data, workspaceId, dedupeKey) {
      return hasOnlyCatalogUniqueKeys(data)
        && data.dedupeKey == dedupeKey
        && data.workspaceId == workspaceId
        && data.catalogItemId is string
        && data.catalogItemId.size() > 0
        && isValidCatalogGroup(data.group)
        && data.normalizedName is string
        && data.normalizedName.size() > 0
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.updatedBy is string
        && data.updatedBy.size() > 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function canReadWorkspaceScopedData(workspaceId) {
  return isMember(workspaceId) || isWorkspaceOwnerByParent(workspaceId);
}

function canWriteWorkspaceScopedData(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin']) || isWorkspaceOwnerByParent(workspaceId);
}

function canMemberWriteWorkspaceScopedData(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin', 'member']) ||
    isWorkspaceOwnerByParent(workspaceId);
}

// O backend concede `owner` a quem é `ownerId` do workspace mesmo sem
// documento de membership (creditCards/auth.ts, investments/infrastructure.ts).
// As Rules acompanham: um owner não pode ficar trancado fora da própria
// carteira, vendo tela vazia sobre dados que ele mesmo pode escrever.
function canReadInvestmentDomain(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin', 'member']) ||
    isWorkspaceOwnerByParent(workspaceId);
}

function canReadSensitiveInvestmentDomain(workspaceId) {
  return hasRole(workspaceId, ['owner', 'admin']) ||
    isWorkspaceOwnerByParent(workspaceId);
}

// NOTA M4 — não existe validação de conteúdo em `list`.
//
// Regras não são filtros: numa consulta o Firestore precisa decidir a partir
// das restrições da própria query, sem documento concreto, então qualquer
// predicado sobre `resource.data` numa cláusula `list` é inavaliável e nega a
// consulta inteira — verificado no Emulator com documento bem formado.
//
// O isolamento de tenant na listagem é garantido pelo path: só se lista o que
// está sob `workspaces/{workspaceId}`. A coerência entre o campo
// `workspaceId` e o path é imposta na escrita, pelo backend
// (`assertInvestmentDocument`), que é a camada onde ela é exequível.
function isBoundedInvestmentList() {
  return request.query.limit != null &&
    request.query.limit > 0 &&
    request.query.limit <= 100;
}

function isInvestmentString(value, maxSize) {
  return value is string && value.size() > 0 && value.size() <= maxSize;
}

function isInvestmentProfileType(value) {
  return value in ['PF', 'PJ'];
}

function isInvestmentCurrency(value) {
  return value == 'BRL';
}

function isInvestmentInteger(value) {
  return value is int &&
    value >= -9007199254740991 && value <= 9007199254740991;
}

function isNonNegativeInvestmentInteger(value) {
  return isInvestmentInteger(value) && value >= 0;
}

function hasValidInvestmentIdentity(data, workspaceId, docId) {
  return data.id == docId &&
    data.workspaceId == workspaceId &&
    isInvestmentProfileType(data.profileType);
}

function isValidInvestmentAccount(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'name', 'institutionName',
      'currency', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.name, 160) &&
    isInvestmentString(data.institutionName, 160) &&
    isInvestmentCurrency(data.currency) &&
    data.status in ['active', 'archived'] &&
    isInvestmentString(data.createdBy, 128) &&
    isInvestmentString(data.updatedBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    (!data.keys().hasAny(['archivedAt']) || data.archivedAt is timestamp) &&
    (!data.keys().hasAny(['archivedBy']) || isInvestmentString(data.archivedBy, 128)) &&
    (!data.keys().hasAny(['archiveReason']) || isInvestmentString(data.archiveReason, 500));
}

function isValidInvestmentAsset(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'name', 'assetType', 'currency',
      'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.name, 160) &&
    isInvestmentString(data.assetType, 80) &&
    (!data.keys().hasAny(['allocationPurpose']) ||
      data.allocationPurpose in [
        'unassigned', 'retirement', 'goal', 'reserve',
        'financial_application', 'reinvestment', 'fixed_asset'
      ]) &&
    (!data.keys().hasAny(['allocationPurpose']) ||
      (data.profileType == 'PF' &&
        data.allocationPurpose in ['unassigned', 'retirement', 'goal']) ||
      (data.profileType == 'PJ' &&
        data.allocationPurpose in [
          'unassigned', 'reserve', 'financial_application',
          'reinvestment', 'fixed_asset'
        ])) &&
    (!data.keys().hasAny(['symbol']) || isInvestmentString(data.symbol, 32)) &&
    isInvestmentCurrency(data.currency) &&
    data.status in ['active', 'archived'] &&
    isInvestmentString(data.createdBy, 128) &&
    isInvestmentString(data.updatedBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    (!data.keys().hasAny(['archivedAt']) || data.archivedAt is timestamp) &&
    (!data.keys().hasAny(['archivedBy']) || isInvestmentString(data.archivedBy, 128)) &&
    (!data.keys().hasAny(['archiveReason']) || isInvestmentString(data.archiveReason, 500));
}

function isValidInvestmentMovement(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'domainVersion',
      'calculationVersion', 'accountId', 'assetId', 'positionId',
      'operation', 'status', 'currency', 'description', 'principalCents',
      'gainCents', 'feesCents', 'taxCents', 'quantityMicros',
      'cashDeltaCents', 'principalDeltaCents', 'realizedGainDeltaCents',
      'feesDeltaCents', 'taxDeltaCents', 'quantityDeltaMicros',
      'goalNetContributionDeltaCents', 'goalCurrentValueDeltaCents',
      'correlationId', 'idempotencyKeyHash', 'occurredAt', 'createdBy',
      'createdAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    data.domainVersion == 2 &&
    isInvestmentString(data.calculationVersion, 100) &&
    isInvestmentString(data.accountId, 128) &&
    isInvestmentString(data.assetId, 128) &&
    isInvestmentString(data.positionId, 257) &&
    data.operation in ['contribution', 'redemption', 'reversal', 'goal_link', 'goal_unlink'] &&
    data.status in ['pending', 'settled', 'cancelled'] &&
    isInvestmentCurrency(data.currency) &&
    isInvestmentString(data.description, 500) &&
    isNonNegativeInvestmentInteger(data.principalCents) &&
    isNonNegativeInvestmentInteger(data.gainCents) &&
    isNonNegativeInvestmentInteger(data.feesCents) &&
    isNonNegativeInvestmentInteger(data.taxCents) &&
    isNonNegativeInvestmentInteger(data.quantityMicros) &&
    isInvestmentInteger(data.cashDeltaCents) &&
    isInvestmentInteger(data.principalDeltaCents) &&
    isInvestmentInteger(data.realizedGainDeltaCents) &&
    isInvestmentInteger(data.feesDeltaCents) &&
    isInvestmentInteger(data.taxDeltaCents) &&
    isInvestmentInteger(data.quantityDeltaMicros) &&
    isInvestmentInteger(data.goalNetContributionDeltaCents) &&
    isInvestmentInteger(data.goalCurrentValueDeltaCents) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.idempotencyKeyHash, 128) &&
    data.occurredAt is timestamp && data.createdAt is timestamp &&
    isInvestmentString(data.createdBy, 128) &&
    (!data.keys().hasAny(['settlementAt']) || data.settlementAt is timestamp) &&
    (!data.keys().hasAny(['settledAt']) || data.settledAt is timestamp) &&
    (!data.keys().hasAny(['settledBy']) || isInvestmentString(data.settledBy, 128)) &&
    (
      (data.status == 'pending' &&
        hasZeroInvestmentMovementDeltas(data) &&
        !data.keys().hasAny(['settledAt', 'settledBy'])) ||
      (data.status == 'cancelled' &&
        hasZeroInvestmentMovementDeltas(data) &&
        !data.keys().hasAny(['settledAt', 'settledBy']) &&
        data.cancelledAt is timestamp &&
        isInvestmentString(data.cancelledBy, 128)) ||
      (data.status == 'settled' && data.settlementAt is timestamp &&
        data.settledAt is timestamp && isInvestmentString(data.settledBy, 128))
    );
}

function hasZeroInvestmentMovementDeltas(data) {
  return data.cashDeltaCents == 0 && data.principalDeltaCents == 0 &&
    data.realizedGainDeltaCents == 0 && data.feesDeltaCents == 0 &&
    data.taxDeltaCents == 0 && data.quantityDeltaMicros == 0 &&
    data.goalNetContributionDeltaCents == 0 &&
    data.goalCurrentValueDeltaCents == 0;
}

function isValidInvestmentPosition(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'accountId', 'assetId', 'currency',
      'status', 'quantityMicros', 'principalCents', 'realizedGainCents',
      'feesCents', 'taxCents', 'currentValueCents',
      'unrealizedAppreciationCents', 'calculationVersion', 'version',
      'createdAt', 'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.accountId, 128) &&
    isInvestmentString(data.assetId, 128) &&
    isInvestmentCurrency(data.currency) &&
    data.status in ['active', 'archived'] &&
    isNonNegativeInvestmentInteger(data.quantityMicros) &&
    isNonNegativeInvestmentInteger(data.principalCents) &&
    isNonNegativeInvestmentInteger(data.realizedGainCents) &&
    isNonNegativeInvestmentInteger(data.feesCents) &&
    isNonNegativeInvestmentInteger(data.taxCents) &&
    isNonNegativeInvestmentInteger(data.currentValueCents) &&
    isInvestmentInteger(data.unrealizedAppreciationCents) &&
    isInvestmentString(data.calculationVersion, 100) &&
    isNonNegativeInvestmentInteger(data.version) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

function isValidInvestmentValuation(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'accountId', 'assetId', 'currency',
      'unitPriceMicros', 'source', 'effectiveAt', 'correlationId',
      'createdBy', 'createdAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.accountId, 128) &&
    isInvestmentString(data.assetId, 128) &&
    isInvestmentCurrency(data.currency) &&
    isNonNegativeInvestmentInteger(data.unitPriceMicros) &&
    data.unitPriceMicros > 0 &&
    data.source in ['manual', 'provider', 'import'] &&
    data.effectiveAt is timestamp && data.createdAt is timestamp &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.createdBy, 128);
}

function isValidInvestmentSnapshot(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'kind', 'targetId', 'status',
      'cutoffAt', 'processedCount', 'expectedProjectionVersion', 'totals',
      'pageSize', 'calculationVersion', 'correlationId', 'createdBy',
      'createdAt', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    data.kind in [
      'position_rebuild', 'goal_rebuild',
      'projection_rebuild', 'workspace_backfill', 'legacy_migration'
    ] &&
    isInvestmentString(data.targetId, 257) &&
    data.status in ['running', 'completed'] &&
    data.cutoffAt is timestamp &&
    isNonNegativeInvestmentInteger(data.processedCount) &&
    isNonNegativeInvestmentInteger(data.expectedProjectionVersion) &&
    data.totals is map &&
    isInvestmentInteger(data.totals.quantityMicros) &&
    isInvestmentInteger(data.totals.principalCents) &&
    isInvestmentInteger(data.totals.realizedGainCents) &&
    isInvestmentInteger(data.totals.feesCents) &&
    isInvestmentInteger(data.totals.taxCents) &&
    isInvestmentInteger(data.totals.netContributionCents) &&
    isInvestmentInteger(data.totals.currentValueCents) &&
    isNonNegativeInvestmentInteger(data.pageSize) &&
    data.pageSize > 0 && data.pageSize <= 100 &&
    isInvestmentString(data.calculationVersion, 100) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.createdBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    (!data.keys().hasAny(['completedAt']) || data.completedAt is timestamp);
}

function isValidInvestmentEventLog(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'actorId', 'actorRole',
      'operation', 'entityType', 'entityId', 'correlationId',
      'idempotencyKeyId', 'outcome', 'details', 'occurredAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentString(data.actorId, 128) &&
    data.actorRole in ['owner', 'admin', 'member'] &&
    isInvestmentString(data.operation, 128) &&
    data.entityType in [
      'account', 'asset', 'movement', 'position', 'goal', 'snapshot',
      'importBatch'
    ] &&
    isInvestmentString(data.entityId, 257) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.idempotencyKeyId, 257) &&
    data.outcome == 'completed' && data.details is map &&
    data.occurredAt is timestamp;
}

// Evento de falha: gravado fora da transação de negócio, que já abortou, e
// por isso sem `profileType`/`actorRole` — não há leitura de workspace nem de
// membership disponível nesse ponto.
function isValidInvestmentFailureEventLog(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'operation', 'entityType', 'entityId',
      'outcome', 'details', 'occurredAt'
    ]) &&
    data.workspaceId == workspaceId && data.id == docId &&
    isInvestmentString(data.operation, 128) &&
    data.entityType == 'operation' &&
    isInvestmentString(data.entityId, 257) &&
    data.outcome == 'failed' && data.details is map &&
    data.occurredAt is timestamp;
}

function isValidInvestmentImportBatch(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'status', 'source',
      'processedCount', 'failedCount', 'correlationId', 'createdBy',
      'createdAt', 'updatedAt'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    data.status in ['pending', 'running', 'completed', 'failed'] &&
    isInvestmentString(data.source, 160) &&
    isNonNegativeInvestmentInteger(data.processedCount) &&
    isNonNegativeInvestmentInteger(data.failedCount) &&
    isInvestmentString(data.correlationId, 128) &&
    isInvestmentString(data.createdBy, 128) &&
    data.createdAt is timestamp && data.updatedAt is timestamp &&
    (!data.keys().hasAny(['completedAt']) || data.completedAt is timestamp);
}

function isValidInvestmentReportPeriod(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'currency', 'period',
      'periodStart', 'contributionCents', 'redemptionPrincipalCents',
      'realizedGainCents', 'feesCents', 'taxCents', 'costDeltaCents',
      'currentValueDeltaCents', 'cashDeltaCents', 'settledMovementCount',
      'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentCurrency(data.currency) &&
    data.period is string &&
    data.period == docId &&
    data.period.matches('^\\d{4}-\\d{2}$') &&
    data.periodStart is timestamp &&
    isInvestmentInteger(data.contributionCents) &&
    isInvestmentInteger(data.redemptionPrincipalCents) &&
    isInvestmentInteger(data.realizedGainCents) &&
    isInvestmentInteger(data.feesCents) &&
    isInvestmentInteger(data.taxCents) &&
    isInvestmentInteger(data.costDeltaCents) &&
    isInvestmentInteger(data.currentValueDeltaCents) &&
    isInvestmentInteger(data.cashDeltaCents) &&
    isInvestmentInteger(data.settledMovementCount) &&
    (!data.keys().hasAny(['daily']) || data.daily is map) &&
    data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

function isValidInvestmentAllocationSummary(data, workspaceId, docId) {
  return data.keys().hasAll([
      'id', 'workspaceId', 'profileType', 'currency', 'dimension', 'key',
      'label', 'positionCount', 'principalCents', 'currentValueCents',
      'realizedGainCents', 'feesCents', 'taxCents', 'updatedAt', 'updatedBy'
    ]) &&
    hasValidInvestmentIdentity(data, workspaceId, docId) &&
    isInvestmentCurrency(data.currency) &&
    data.dimension in [
      'account', 'class', 'asset', 'goal', 'risk', 'liquidity',
      'indexer', 'purpose'
    ] &&
    isInvestmentString(data.key, 257) &&
    isInvestmentString(data.label, 160) &&
    isInvestmentInteger(data.positionCount) &&
    isInvestmentInteger(data.principalCents) &&
    isInvestmentInteger(data.currentValueCents) &&
    isInvestmentInteger(data.realizedGainCents) &&
    isInvestmentInteger(data.feesCents) &&
    isInvestmentInteger(data.taxCents) &&
    data.updatedAt is timestamp &&
    isInvestmentString(data.updatedBy, 128);
}

function isValidLegacyInvestmentAudit(data, workspaceId) {
  return data.workspaceId == workspaceId &&
    isInvestmentProfileType(data.profileType) &&
    isInvestmentString(data.actorId, 128) &&
    data.actorRole in ['owner', 'admin', 'member'] &&
    isInvestmentString(data.operation, 128) &&
    isInvestmentString(data.targetId, 257) &&
    isInvestmentString(data.correlationId, 257) &&
    data.details is map && data.timestamp is timestamp;
}

// Coleções cuja escrita é exclusiva do backend/Admin SDK e cuja leitura é
// governada por um bloco `match` próprio. Derivada de prefixo, e não de uma
// enumeração mantida à mão: uma coleção nova do domínio nasce negada no
// catch-all em vez de herdar leitura de qualquer membro.
function isBackendOwnedCollection(collectionName) {
  return collectionName.matches('^(investment_|credit_card_|goal_).*') ||
    collectionName in [
      'card_limit_ledger',
      'card_limit_snapshots',
      'invoice_views',
      'financial_events'
    ];
}

function isValidCreditCardStatus(value) {
  return value in ['active', 'blocked', 'cancelled'];
}

function isValidCardBrand(value) {
  return value is string && value.size() > 0 && value.size() <= 40;
}

function isValidBillingDay(value) {
  return value is int && value >= 1 && value <= 31;
}

function isValidOptionalString(value, maxSize) {
  return value is string && value.size() <= maxSize;
}

function isValidCreditCardVisual(visual) {
  return visual is map
    && visual.keys().hasOnly([
      'bgType',
      'bgColor',
      'bgGradientColor',
      'bgImage',
      'textColor',
      'showName',
      'showBrand',
      'showLogo'
    ])
    && visual.bgType in ['color', 'gradient', 'image']
    && visual.bgColor is string
    && visual.bgColor.size() > 0
    && (!visual.keys().hasAny(['bgGradientColor']) || visual.bgGradientColor is string)
    && (!visual.keys().hasAny(['bgImage']) || visual.bgImage is string)
    && visual.textColor in ['white', 'black']
    && visual.showName is bool
    && visual.showBrand is bool
    && visual.showLogo is bool;
}

function hasOnlyCreditCardKeys(data) {
  return data.keys().hasOnly([
    'workspaceId',
    'name',
    'brand',
    'status',
    'limitTotal',
    'limitUsed',
    'limitAvailable',
    'closingDay',
    'dueDay',
    'bestDay',
    'billingCycleStatus',
    'observations',
    'visual',
    'profileId',
    'responsiblePerson',
    'recommendedUse',
    'defaultCostCenter',
    'createdAt',
    'updatedAt'
  ]);
}

function isValidCreditCardPayload(data, workspaceId) {
  return hasOnlyCreditCardKeys(data)
    && data.workspaceId == workspaceId
    && data.name is string
    && data.name.size() > 0
    && data.name.size() <= 80
    && isValidCardBrand(data.brand)
    && isValidCreditCardStatus(data.status)
    && (data.limitTotal is int || data.limitTotal is float)
    && data.limitTotal > 0
    && isValidBillingDay(data.closingDay)
    && isValidBillingDay(data.dueDay)
    && (!data.keys().hasAny(['bestDay']) || isValidBillingDay(data.bestDay))
    && (!data.keys().hasAny(['billingCycleStatus']) || data.billingCycleStatus in ['idle', 'open', 'closing', 'closed', 'overdue'])
    && (!data.keys().hasAny(['observations']) || isValidOptionalString(data.observations, 500))
    && (!data.keys().hasAny(['profileId']) || isValidOptionalString(data.profileId, 120))
    && (!data.keys().hasAny(['responsiblePerson']) || isValidOptionalString(data.responsiblePerson, 120))
    && (!data.keys().hasAny(['recommendedUse']) || isValidOptionalString(data.recommendedUse, 300))
    && (!data.keys().hasAny(['defaultCostCenter']) || isValidOptionalString(data.defaultCostCenter, 120))
    && (!data.keys().hasAny(['visual']) || isValidCreditCardVisual(data.visual))
    && (!data.keys().hasAny(['createdAt']) || data.createdAt is timestamp)
    && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp);
}

function isValidCreditCardCreate(data, workspaceId) {
  return canWriteWorkspaceScopedData(workspaceId)
    && isValidCreditCardPayload(data, workspaceId)
    && data.createdAt is timestamp
    && data.updatedAt is timestamp
    && !data.keys().hasAny(['limitUsed'])
    && !data.keys().hasAny(['limitAvailable']);
}

function isValidCreditCardUpdate(data, previous, workspaceId) {
  return canWriteWorkspaceScopedData(workspaceId)
    && isValidCreditCardPayload(data, workspaceId)
    && data.workspaceId == previous.workspaceId
    && (!previous.keys().hasAny(['createdAt']) || data.createdAt == previous.createdAt)
    && (
      (!previous.keys().hasAny(['limitUsed']) && !data.keys().hasAny(['limitUsed'])) ||
      (previous.keys().hasAny(['limitUsed']) && data.limitUsed == previous.limitUsed)
    )
    && (
      (!previous.keys().hasAny(['limitAvailable']) && !data.keys().hasAny(['limitAvailable'])) ||
      (previous.keys().hasAny(['limitAvailable']) && data.limitAvailable == previous.limitAvailable)
    );
}

    match /workspaces/{workspaceId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isMember(workspaceId) || (signedIn() && resource.data.ownerId == request.auth.uid);
      // M4.C — `ownerId`, `type` (PF/PJ) e `features` são críticos: reescrever
      // `ownerId` era takeover permanente disponível a qualquer admin, e `type`
      // é a fonte em que `profileTypeFromWorkspace` confia para o contexto
      // contábil. Transferência de titularidade passa a exigir backend.
      allow update: if
        (hasRole(workspaceId, ['owner', 'admin']) ||
          (signedIn() && resource.data.ownerId == request.auth.uid)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'ownerId', 'type', 'features', 'userId', 'createdAt'
        ]);

      match /members/{memberId} {
        allow read: if
          (signedIn() && resource.data.uid == request.auth.uid) ||
          isMember(workspaceId) ||
          isWorkspaceOwnerByParent(workspaceId);

        // M4.C — a escrita não tinha nenhuma validação de payload: um admin
        // gravava `role: 'owner'` no próprio documento e virava owner. Agora:
        // o papel vem de um enum, o `uid` é fixado no ID do documento,
        // ninguém altera o próprio papel a menos que seja o `ownerId` real do
        // workspace, e conceder ou alterar `owner` exige owner.
        allow create, update: if
          (hasRole(workspaceId, ['owner', 'admin']) ||
            isWorkspaceOwnerByParent(workspaceId)) &&
          request.resource.data.uid == memberId &&
          isWorkspaceRoleName(request.resource.data.role) &&
          (!request.resource.data.keys().hasAny(['status']) ||
            request.resource.data.status is string) &&
          (request.auth.uid != memberId ||
            isWorkspaceOwnerByParent(workspaceId) ||
            (resource != null && resource.data.role == request.resource.data.role)) &&
          (request.resource.data.role != 'owner' ||
            hasRole(workspaceId, ['owner']) ||
            isWorkspaceOwnerByParent(workspaceId)) &&
          (resource == null ||
            resource.data.role != 'owner' ||
            hasRole(workspaceId, ['owner']) ||
            isWorkspaceOwnerByParent(workspaceId));

        // Remover o documento de membership do owner o converte de
        // gated-por-papel para gated-por-parent e lhe retira a leitura do
        // domínio; só o próprio owner do workspace pode fazê-lo.
        allow delete: if
          (hasRole(workspaceId, ['owner', 'admin']) ||
            isWorkspaceOwnerByParent(workspaceId)) &&
          (resource.data.role != 'owner' ||
            isWorkspaceOwnerByParent(workspaceId));
      }

      match /transactions/{docId} {
        allow read: if isMember(workspaceId) || isWorkspaceOwnerByParent(workspaceId);

        allow create: if
          (hasRole(workspaceId, ['owner', 'admin', 'member']) || isWorkspaceOwnerByParent(workspaceId)) &&
          isCommonValidTransactionPayload(request.resource.data, workspaceId) &&
          hasOnlyClientTransactionKeys(request.resource.data) &&
          isLegacyInvestmentWriteAllowed(workspaceId, request.resource.data) &&
          request.resource.data.workspaceId == workspaceId &&
          request.resource.data.userId == request.auth.uid &&
          !request.resource.data.keys().hasAny([
            'goalId',
            'investmentMetadata',
            'redeemedPrincipalCents',
            'remainingPrincipalCents',
            'settlementDate'
          ]);

        allow update: if
          (
            (hasRole(workspaceId, ['owner', 'admin']) || isWorkspaceOwnerByParent(workspaceId)) &&
            isCommonValidTransactionPayload(request.resource.data, workspaceId) &&
            request.resource.data.userId == resource.data.userId &&
            !resource.data.keys().hasAny(['goalId']) &&
            !request.resource.data.keys().hasAny(['goalId']) &&
            !resource.data.keys().hasAny(['investmentMetadata']) &&
            !request.resource.data.keys().hasAny(['investmentMetadata']) &&
            !resource.data.keys().hasAny(['redeemedPrincipalCents', 'remainingPrincipalCents', 'settlementDate']) &&
            !request.resource.data.keys().hasAny(['redeemedPrincipalCents', 'remainingPrincipalCents', 'settlementDate']) &&
            changesOnlyMutableTransactionKeys()
          ) ||
          (
            isMemberTransactionOwner(workspaceId, resource.data) &&
            isCommonValidTransactionPayload(request.resource.data, workspaceId) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId &&
            !resource.data.keys().hasAny(['goalId']) &&
            !request.resource.data.keys().hasAny(['goalId']) &&
            !resource.data.keys().hasAny(['investmentMetadata']) &&
            !request.resource.data.keys().hasAny(['investmentMetadata']) &&
            !resource.data.keys().hasAny(['redeemedPrincipalCents', 'remainingPrincipalCents', 'settlementDate']) &&
            !request.resource.data.keys().hasAny(['redeemedPrincipalCents', 'remainingPrincipalCents', 'settlementDate']) &&
            changesOnlyMutableTransactionKeys()
          );

        allow delete: if
          !resource.data.keys().hasAny(['goalId']) &&
          !resource.data.keys().hasAny(['investmentMetadata']) &&
          !resource.data.keys().hasAny([
            'redeemedPrincipalCents',
            'remainingPrincipalCents',
            'settlementDate'
          ]) &&
          (
            hasRole(workspaceId, ['owner', 'admin']) ||
            isWorkspaceOwnerByParent(workspaceId) ||
            isMemberTransactionOwner(workspaceId, resource.data)
          );
      }

     match /recurring_expenses/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /recurring_occurrences/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

      match /credit_cards/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);

  allow create: if isValidCreditCardCreate(request.resource.data, workspaceId);

  allow update: if isValidCreditCardUpdate(
    request.resource.data,
    resource.data,
    workspaceId
  );

  allow delete: if canWriteWorkspaceScopedData(workspaceId);
}

      match /credit_card_purchases/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_installments/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_invoices/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_invoice_payments/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /card_limit_ledger/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /financial_events/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /invoice_views/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_audit_logs/{docId} {
  allow read: if canWriteWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_operational_metrics/{docId} {
  allow read: if canWriteWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /card_limit_snapshots/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if false;
}

match /credit_card_idempotency_keys/{docId} {
  allow read: if false;
  allow write: if false;
}

      match /goals/{docId} {
        allow read: if isMember(workspaceId) || isWorkspaceOwnerByParent(workspaceId);
        allow write: if false;
      }

      match /goal_audit_logs/{docId} {
        allow read: if canWriteWorkspaceScopedData(workspaceId);
        allow write: if false;
      }

      match /goal_idempotency_keys/{docId} {
        allow read, write: if false;
      }

      match /investment_audit_logs/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isValidLegacyInvestmentAudit(resource.data, workspaceId);
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_accounts/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAccount(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_assets/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAsset(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_movements/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentMovement(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_positions/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentPosition(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_valuations/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentValuation(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_snapshots/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isValidInvestmentSnapshot(resource.data, workspaceId, docId);
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_event_logs/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) && (
          isValidInvestmentEventLog(resource.data, workspaceId, docId) ||
          isValidInvestmentFailureEventLog(resource.data, workspaceId, docId)
        );
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_import_batches/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isValidInvestmentImportBatch(resource.data, workspaceId, docId);
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_operational_metrics/{docId} {
        allow get: if canReadSensitiveInvestmentDomain(workspaceId) &&
          resource.data.workspaceId == workspaceId &&
          resource.data.id == docId &&
          resource.data.domain == 'investment' &&
          resource.data.status in ['success', 'failure'] &&
          isInvestmentString(resource.data.operation, 128) &&
          isNonNegativeInvestmentInteger(resource.data.count) &&
          resource.data.updatedAt is timestamp;
        allow list: if canReadSensitiveInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_idempotency_keys/{docId} {
        allow read, write: if false;
      }

      match /investment_summaries/{docId} {
        allow get: if docId == 'current' &&
          canReadInvestmentDomain(workspaceId) &&
          resource.data.workspaceId == workspaceId &&
          resource.data.id == docId &&
          isInvestmentProfileType(resource.data.profileType) &&
          resource.data.currency == 'BRL' &&
          isNonNegativeInvestmentInteger(resource.data.positionCount) &&
          isNonNegativeInvestmentInteger(resource.data.principalCents) &&
          isNonNegativeInvestmentInteger(resource.data.currentValueCents) &&
          isNonNegativeInvestmentInteger(resource.data.realizedGainCents) &&
          isNonNegativeInvestmentInteger(resource.data.feesCents) &&
          isNonNegativeInvestmentInteger(resource.data.taxCents) &&
          resource.data.unrealizedAppreciationCents is int &&
          resource.data.updatedAt is timestamp;
        allow list, write: if false;
      }

      match /investment_report_periods/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentReportPeriod(resource.data, workspaceId, docId);
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /investment_allocation_summaries/{docId} {
        allow get: if canReadInvestmentDomain(workspaceId) &&
          isValidInvestmentAllocationSummary(
            resource.data,
            workspaceId,
            docId
          );
        allow list: if canReadInvestmentDomain(workspaceId) &&
          isBoundedInvestmentList();
        allow write: if false;
      }

      match /loans/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /loan_movements/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /clients/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /receivables/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /notifications/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);

  allow create: if false;

  allow update: if
    canReadWorkspaceScopedData(workspaceId) &&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
    request.resource.data.read is bool;

  allow delete: if canWriteWorkspaceScopedData(workspaceId);
}

match /split_groups/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /split_participants/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /split_bills/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

match /split_shares/{docId} {
  allow read: if canReadWorkspaceScopedData(workspaceId);
  allow write: if canMemberWriteWorkspaceScopedData(workspaceId);
}

      match /settings_catalog/{docId} {
        allow read: if isMember(workspaceId) || isWorkspaceOwnerByParent(workspaceId);

        allow create: if isValidCatalogCreate(request.resource.data, workspaceId);

        allow update: if isValidCatalogUpdate(
          request.resource.data,
          resource.data,
          workspaceId
        );

        allow delete: if false;
      }

      match /settings_catalog_uniques/{dedupeKey} {
        allow read: if isMember(workspaceId) || isWorkspaceOwnerByParent(workspaceId);

        allow create: if
          canManageWorkspaceCatalog(workspaceId) &&
          isValidCatalogUniquePayload(request.resource.data, workspaceId, dedupeKey) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.updatedBy == request.auth.uid;

        allow update: if
          canManageWorkspaceCatalog(workspaceId) &&
          isValidCatalogUniquePayload(request.resource.data, workspaceId, dedupeKey) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.updatedBy == request.auth.uid;

        allow delete: if false;
      }

          match /{subCollection}/{docId} {
        allow read: if
          !isBackendOwnedCollection(subCollection) &&
          canReadWorkspaceScopedData(workspaceId);

        allow write: if false;
      }
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /workspaces/{workspaceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
