rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Auxiliares
    function signedIn() {
      return request.auth != null;
    }

    // Verifica papel na subcoleção members
    function getMemberRole(workspaceId) {
       return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    // Verifica se é membro (para acesso geral ao workspace)
    function isMember(workspaceId) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // Verifica permissões específicas
    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && getMemberRole(workspaceId) in roles;
    }

    // --- REGRAS DAS COLEÇÕES ---

    match /workspaces/{workspaceId} {
      // Leitura do Workspace pai
      allow read: if isMember(workspaceId);
      
      // Apenas Admin/Owner editam dados do workspace
      allow update: if hasRole(workspaceId, ['owner', 'admin']);
      
      // Criação livre
      allow create: if signedIn(); 

      // --- SUBCOLEÇÃO MEMBERS (O CORAÇÃO DO SISTEMA) ---
      match /members/{memberId} {
        // [CORREÇÃO AQUI]: Adicionamos "resource.data.uid == request.auth.uid"
        // Isso permite que a query "Meus Workspaces" funcione globalmente sem travar.
        allow read: if resource.data.uid == request.auth.uid || isMember(workspaceId);
        
        // Apenas Owner/Admin gerenciam membros
        allow write: if hasRole(workspaceId, ['owner', 'admin']);
      }

      // Demais subcoleções
      match /transactions/{transactionId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }
      
      match /{subCollection}/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}