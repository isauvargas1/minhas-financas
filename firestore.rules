rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---
    function signedIn() {
      return request.auth != null;
    }

    // Verifica se o usuário já é membro (usado para ler dados internos)
    function isMember(workspaceId) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    // Busca o papel (role) do usuário
    function getRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    // Verifica permissões de Admin/Owner
    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && getRole(workspaceId) in roles;
    }

    // Verifica se o usuário é o DONO do Workspace (checa o documento pai)
    // Essencial para o primeiro acesso (criação do membro owner)
    function isWorkspaceOwner(workspaceId) {
      return signedIn() && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // --- REGRAS DE NEGÓCIO ---

    match /workspaces/{workspaceId} {
      // Criação livre, leitura/edição restrita
      allow create: if signedIn();
      allow read: if isMember(workspaceId);
      allow update: if hasRole(workspaceId, ['owner', 'admin']);
      
      // SUBCOLEÇÃO MEMBERS
      match /members/{memberId} {
        
        // LEITURA (Correção para listWorkspaces):
        // Separamos em duas regras. Se QUALQUER UMA for verdade, libera.
        
        // Regra 1: Permite query global "Meus Workspaces" (onde uid == auth.uid)
        allow read: if resource.data.uid == request.auth.uid;
        
        // Regra 2: Permite ver colegas se já estiver dentro do workspace
        allow read: if isMember(workspaceId);

        // ESCRITA (Correção para createWorkspace - REINSERIDA):
        // 1. Admin/Owner podem gerenciar.
        // 2. O PRÓPRIO DONO pode se adicionar como membro se o workspace disser que ele é o dono.
        allow write: if hasRole(workspaceId, ['owner', 'admin']) 
                     || (request.auth.uid == memberId && isWorkspaceOwner(workspaceId));
      }

      // Demais subcoleções
      match /transactions/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }
      
      match /{subCollection}/{docId} {
        allow read: if isMember(workspaceId);
        allow write: if hasRole(workspaceId, ['owner', 'admin', 'member']);
      }
    }

    // Bloqueio padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}