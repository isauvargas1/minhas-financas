{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "node \"$PROJECT_DIR/tools/deploy/guarda-predeploy.mjs\" firestore"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "src/**/__tests__/**",
        "src/**/testSupport/**",
        "src/**/*.test.ts",
        "lib/**/__tests__/**",
        "lib/**/testSupport/**",
        "lib/**/*.test.js",
        "lib/**/*.test.js.map"
      ],
      "predeploy": [
        "node \"$PROJECT_DIR/tools/deploy/guarda-predeploy.mjs\" functions",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "predeploy": [
      "node \"$PROJECT_DIR/tools/deploy/guarda-predeploy.mjs\" hosting",
      "node \"$PROJECT_DIR/tools/seguranca/varrer-bundle.mjs\" \"$PROJECT_DIR/dist\" --perfil release --publicacao"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "fenix-build.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules",
    "predeploy": [
      "node \"$PROJECT_DIR/tools/deploy/guarda-predeploy.mjs\" storage"
    ]
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
