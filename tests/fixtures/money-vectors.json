{
  "description": "Vetores compartilhados de dinheiro em centavos (P1; D-16, D-34). Exercitados por functions/src/shared/__tests__/money.test.ts (backend) e tests/unit/money.test.ts (frontend). \"error\" significa que a operação deve recusar a entrada.",
  "limits": {
    "maxSafeCents": 9007199254740991,
    "minSafeCents": -9007199254740991
  },
  "parse": [
    {"input": "0", "expected": 0},
    {"input": "0,00", "expected": 0},
    {"input": "-0", "expected": 0},
    {"input": "-0,00", "expected": 0},
    {"input": "R$ 0,01", "expected": 1},
    {"input": "0,1", "expected": 10},
    {"input": "1", "expected": 100},
    {"input": "1,5", "expected": 150},
    {"input": "10,50", "expected": 1050},
    {"input": "1.234", "expected": 123400},
    {"input": "1234", "expected": 123400},
    {"input": "1.234,56", "expected": 123456},
    {"input": "1234,56", "expected": 123456},
    {"input": "R$ 1.234,56", "expected": 123456},
    {"input": "R$ 1.234,56", "expected": 123456},
    {"input": "  R$ 1.234,56  ", "expected": 123456},
    {"input": "12.345.678,90", "expected": 1234567890},
    {"input": "-10,5", "expected": -1050},
    {"input": "R$ -1,00", "expected": -100},
    {"input": "-R$ 1,00", "expected": -100},
    {"input": "-R$ 0,01", "expected": -1},
    {"input": "+5", "expected": 500},
    {"input": "+R$ 5,00", "expected": 500},
    {"input": "90.071.992.547.409,91", "expected": 9007199254740991},
    {"input": "90071992547409,91", "expected": 9007199254740991},
    {"input": "-90.071.992.547.409,91", "expected": -9007199254740991},
    {"input": "90.071.992.547.409,92", "expected": "error"},
    {"input": "90071992547409,92", "expected": "error"},
    {"input": "-90.071.992.547.409,92", "expected": "error"},
    {"input": "99999999999999999999", "expected": "error"},
    {"input": "10,555", "expected": "error"},
    {"input": "0,001", "expected": "error"},
    {"input": "10.50", "expected": "error"},
    {"input": "1.23", "expected": "error"},
    {"input": "1.2345", "expected": "error"},
    {"input": "1234.567", "expected": "error"},
    {"input": "1.234.56", "expected": "error"},
    {"input": "abc", "expected": "error"},
    {"input": "", "expected": "error"},
    {"input": "   ", "expected": "error"},
    {"input": "R$", "expected": "error"},
    {"input": "R$ ", "expected": "error"},
    {"input": "-", "expected": "error"},
    {"input": ",50", "expected": "error"},
    {"input": "1,", "expected": "error"},
    {"input": "1,2,3", "expected": "error"},
    {"input": "NaN", "expected": "error"},
    {"input": "Infinity", "expected": "error"},
    {"input": "-Infinity", "expected": "error"},
    {"input": "1e3", "expected": "error"},
    {"input": "0x10", "expected": "error"},
    {"input": "--1", "expected": "error"},
    {"input": "-R$ -1,00", "expected": "error"},
    {"input": "+-1", "expected": "error"},
    {"input": "1-", "expected": "error"},
    {"input": "US$ 1,00", "expected": "error"},
    {"input": "1,00 R$", "expected": "error"},
    {"input": "１", "expected": "error"}
  ],
  "allocate": [
    {"total": 100, "weights": [1, 1, 1], "expected": [34, 33, 33]},
    {"total": 1, "weights": [1, 1, 1], "expected": [1, 0, 0]},
    {"total": 2, "weights": [1, 1, 1], "expected": [1, 1, 0]},
    {"total": -100, "weights": [1, 1, 1], "expected": [-34, -33, -33]},
    {"total": -1, "weights": [1, 1, 1], "expected": [-1, 0, 0]},
    {"total": 0, "weights": [1, 2], "expected": [0, 0]},
    {"total": 5, "weights": [1, 1], "expected": [3, 2]},
    {"total": 100, "weights": [0, 1], "expected": [0, 100]},
    {"total": 100, "weights": [7], "expected": [100]},
    {"total": 10, "weights": [1, 2, 3, 4], "expected": [1, 2, 3, 4]},
    {"total": 11, "weights": [1, 2, 3, 4], "expected": [1, 2, 3, 5]},
    {"total": 1000000000000, "weights": [1, 2, 3, 4], "expected": [100000000000, 200000000000, 300000000000, 400000000000]},
    {"total": 999999999999, "weights": [1, 2, 3, 4], "expected": [100000000000, 200000000000, 300000000000, 399999999999]},
    {"total": 9007199254740991, "weights": [1, 2, 3, 4], "expected": [900719925474099, 1801439850948198, 2702159776422297, 3602879701896397]},
    {"total": -9007199254740991, "weights": [1, 2, 3, 4], "expected": [-900719925474099, -1801439850948198, -2702159776422297, -3602879701896397]},
    {"total": 9007199254740991, "weights": [9007199254740991, 1], "expected": [9007199254740990, 1]},
    {"total": 100, "weights": [0, 0], "expected": "error"},
    {"total": 100, "weights": [1, -1], "expected": "error"},
    {"total": 100, "weights": [1.5, 1], "expected": "error"},
    {"total": 100, "weights": [9007199254740992, 1], "expected": "error"},
    {"total": 100, "weights": [], "expected": "error"},
    {"total": 1.5, "weights": [1, 1], "expected": "error"},
    {"total": 9007199254740992, "weights": [1, 1], "expected": "error"}
  ],
  "split": [
    {"total": 100, "count": 3, "expected": [34, 33, 33]},
    {"total": 10, "count": 4, "expected": [3, 3, 2, 2]},
    {"total": -10, "count": 4, "expected": [-3, -3, -2, -2]},
    {"total": 0, "count": 2, "expected": [0, 0]},
    {"total": 1, "count": 1, "expected": [1]},
    {"total": 1, "count": 3, "expected": [1, 0, 0]},
    {"total": 100, "count": 0, "expected": "error"},
    {"total": 100, "count": -1, "expected": "error"},
    {"total": 100, "count": 1.5, "expected": "error"},
    {"total": 1.5, "count": 2, "expected": "error"}
  ],
  "arithmetic": [
    {"op": "add", "left": 1, "right": 2, "expected": 3},
    {"op": "add", "left": 9007199254740990, "right": 1, "expected": 9007199254740991},
    {"op": "add", "left": 9007199254740991, "right": 1, "expected": "error"},
    {"op": "add", "left": 9007199254740991, "right": 9007199254740991, "expected": "error"},
    {"op": "add", "left": -9007199254740991, "right": -1, "expected": "error"},
    {"op": "add", "left": -9007199254740991, "right": 9007199254740991, "expected": 0},
    {"op": "add", "left": 1.5, "right": 1, "expected": "error"},
    {"op": "add", "left": 1, "right": 9007199254740992, "expected": "error"},
    {"op": "subtract", "left": 5, "right": 5, "expected": 0},
    {"op": "subtract", "left": 0, "right": 9007199254740991, "expected": -9007199254740991},
    {"op": "subtract", "left": -9007199254740990, "right": 1, "expected": -9007199254740991},
    {"op": "subtract", "left": -9007199254740991, "right": 1, "expected": "error"},
    {"op": "subtract", "left": 9007199254740991, "right": -1, "expected": "error"},
    {"op": "subtract", "left": 1, "right": 0.5, "expected": "error"}
  ],
  "sum": [
    {"values": [], "expected": 0},
    {"values": [1, 2, 3], "expected": 6},
    {"values": [100, -100], "expected": 0},
    {"values": [9007199254740990, 1], "expected": 9007199254740991},
    {"values": [9007199254740991, 1], "expected": "error"},
    {"values": [1, 0.5], "expected": "error"}
  ]
}
