{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
  "@/*": ["./src/*"],
  "@fenix/app-check": ["./src/lib/ambiente/appCheck.ts"],
  "@fenix/emuladores": ["./src/lib/ambiente/emuladores.ts"],
  "@fenix/login-e2e": ["./src/lib/ambiente/loginE2E.tsx"]
}
,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "index.tsx",
    "src",
    "e2e",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
