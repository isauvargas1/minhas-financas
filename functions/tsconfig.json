{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": "src",
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "lib": ["es2020", "dom", "dom.iterable", "scripthost", "webworker.importscripts"]
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}