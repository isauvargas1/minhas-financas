{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "clean": "node -e \"require('node:fs').rmSync('lib', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test $(find lib -name '*.test.js' ! -name '*.integration.test.js' | sort)",
    "test:integration": "npm run build && node --test --test-concurrency=1 \"lib/**/*.integration.test.js\"",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions --project minhas-financas-local",
    "shell": "npm run build && firebase functions:shell --project minhas-financas-local",
    "start": "npm run shell",
    "deploy": "node ../tools/deploy/publicar.mjs --alvo functions"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "~2.28.0",
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "stripe": "^20.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.7.3"
  },
  "private": true
}
